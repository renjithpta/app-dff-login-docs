@startuml
skinparam shadowing false
skinparam ParticipantBackgroundColor #FFF0A8
skinparam ActivationBackgroundColor #FFF6D2
skinparam ArrowColor #484334
autonumber
participant "Browser" as P0
participant "BFF replica" as P1
participant "Redis" as P2
participant "Identity Provider" as P3
P0 -> P1: Create logout request + CSRF
P1 -> P2: Invalidate shared session
P1 -> P2: Delete token record
P1 --> P0: Clear cookie; return logout URL
P0 -> P3: Top-level OIDC logout
P3 --> P0: Return to registered UI
P0 -> P1: GET session
P1 --> P0: 401 unauthenticated
@enduml
